<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/margin_horizontal_default"
    android:paddingEnd="@dimen/margin_horizontal_default"
    android:paddingTop="@dimen/margin_vertical_large"
    android:paddingBottom="@dimen/margin_vertical_large">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/text_title"
        style="@style/AppTheme.TextAppearance.CardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dialog_troubleshooting_title" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/text_message"
        style="@style/AppTheme.TextAppearance.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_vertical_small"
        android:text="@string/dialog_troubleshooting_message" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_open_website"
        style="@style/AppTheme.Widget.TextButtonOutlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_vertical_large"
        android:text="@string/dialog_troubleshooting_open_website" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_understood"
        style="@style/AppTheme.Widget.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_vertical_default"
        android:text="@string/dialog_troubleshooting_understood" />

</LinearLayout>

