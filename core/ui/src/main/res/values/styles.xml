<?xml version="1.0" encoding="utf-8"?>

<resources>

    <!-- Style for the permission item layout -->
    <style name="AppTheme.Widget.PermissionItemView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">@dimen/margin_vertical_default</item>
        <item name="android:paddingBottom">@dimen/margin_vertical_large</item>
        <item name="android:paddingStart">@dimen/margin_horizontal_default</item>
        <item name="android:paddingEnd">@dimen/margin_horizontal_default</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <!-- SearchView styling -->
    <style name="AppTheme.Widget.SearchView" parent="Widget.MaterialComponents.AutoCompleteTextView.OutlinedBox">
        <item name="android:paddingStart">@dimen/margin_horizontal_small</item>
        <item name="android:paddingEnd">@dimen/margin_horizontal_small</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textColorHint">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">@dimen/text_size_list_item_text_small</item>
    </style>

    <!-- Bottom sheet dialog styling -->
    <style name="AppTheme.Widget.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="android:backgroundTint">?attr/colorSurface</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
    </style>

    <!-- Overlay selector styles -->
    <style name="AppTheme.Overlay.PositionSelector">
        <item name="colorInner">@color/overlayViewAccentPrimary</item>
        <item name="colorOutlinePrimary">@color/overlayViewPrimary</item>
        <item name="colorOutlineSecondary">@color/overlayViewAccentSecondary</item>
        <item name="colorBackground">@color/overlayClickSelectorBackground</item>
        <item name="thickness">@dimen/overlay_selector_thickness</item>
        <item name="cornerRadius">@dimen/overlay_selector_inner_radius</item>
        <item name="radius">@dimen/overlay_selector_radius</item>
        <item name="innerRadius">@dimen/overlay_selector_inner_radius</item>
    </style>

    <style name="AppTheme.Overlay.GestureRecorder">
        <item name="recorderColor">@color/overlayGestureRecorder</item>
        <item name="length">@dimen/overlay_gesture_length</item>
        <item name="thickness">@dimen/overlay_gesture_thickness</item>
    </style>

    <style name="AppTheme.Widget.ClickOffset">
        <item name="colorInner">@color/overlayViewPrimary</item>
        <item name="colorOutlinePrimary">@color/overlayViewAccentSecondary</item>
        <item name="colorBackground">@color/overlayClickSelectorBackground</item>
        <item name="radius">@dimen/overlay_click_offset_radius</item>
        <item name="innerRadius">@dimen/overlay_click_offset_inner_radius</item>
        <item name="thickness">@dimen/overlay_click_offset_thickness</item>
    </style>

</resources>